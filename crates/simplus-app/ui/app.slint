import { Button, ComboBox, SpinBox, AboutSlint, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Card, SectionTitle, Caption } from "components.slint";
import { VaultPage, VaultState } from "vault/page.slint";
import { VaultScreen, VaultPanel, RecordRow, RecordDetail, FieldRow, HistoryRow, NoteRow, Strength, GeneratorOptions } from "vault/state.slint";

export { Theme, VaultState, VaultScreen, VaultPanel, RecordRow, RecordDetail, FieldRow, HistoryRow, NoteRow, Strength, GeneratorOptions }

/// Application-wide settings, persisted by Rust when `save` is called.
export global AppSettings {
    /// 0 = follow system, 1 = light, 2 = dark.
    in-out property <int> theme;
    in-out property <int> auto-lock-minutes: 5;
    in-out property <int> clipboard-clear-seconds: 30;
    callback save();
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> badge;
    in property <bool> selected;
    callback clicked();

    height: 38px;
    border-radius: 6px;
    background: root.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background.darker(0.05) : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Palette.selection-foreground : Palette.foreground;
        }
        if root.badge != "": Text {
            text: root.badge;
            font-size: 10px;
            vertical-alignment: center;
            color: Theme.muted;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ComingSoonPage inherits Rectangle {
    in property <string> title;
    in property <string> description;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 32px;
        SectionTitle {
            text: root.title;
            font-size: Theme.font-title;
            horizontal-alignment: center;
        }
        Caption {
            text: root.description;
            horizontal-alignment: center;
        }
        Caption {
            text: @tr("Coming in a later release. See docs/ROADMAP.md.");
            horizontal-alignment: center;
        }
    }
}

component SettingsPage inherits ScrollView {
    callback theme-changed();
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;
        SectionTitle {
            text: @tr("Settings");
            font-size: Theme.font-title;
        }
        Card {
            height: general.preferred-height;
            general := VerticalLayout {
                padding: 14px;
                spacing: 10px;
                SectionTitle { text: @tr("Appearance"); }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text {
                        text: @tr("Theme");
                        vertical-alignment: center;
                        min-width: 220px;
                        color: Palette.foreground;
                    }
                    ComboBox {
                        model: [@tr("Follow system"), @tr("Light"), @tr("Dark")];
                        current-index <=> AppSettings.theme;
                        selected => {
                            root.theme-changed();
                            AppSettings.save();
                        }
                    }
                }
            }
        }
        Card {
            height: security.preferred-height;
            security := VerticalLayout {
                padding: 14px;
                spacing: 10px;
                SectionTitle { text: @tr("Password manager"); }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text {
                        text: @tr("Lock after inactivity (minutes, 0 = never)");
                        vertical-alignment: center;
                        min-width: 220px;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                    SpinBox {
                        minimum: 0;
                        maximum: 240;
                        value <=> AppSettings.auto-lock-minutes;
                        edited => { AppSettings.save(); }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text {
                        text: @tr("Clear copied passwords after (seconds, 0 = never)");
                        vertical-alignment: center;
                        min-width: 220px;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                    SpinBox {
                        minimum: 0;
                        maximum: 600;
                        value <=> AppSettings.clipboard-clear-seconds;
                        edited => { AppSettings.save(); }
                    }
                }
                Caption { text: @tr("The vault also locks when your computer locks (Windows)."); }
            }
        }
    }
}

component AboutPage inherits ScrollView {
    in property <string> version;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;
        SectionTitle {
            text: "Simplus " + root.version;
            font-size: Theme.font-title;
        }
        Caption { text: @tr("A cross-platform toolbox: password manager, S3 and FTP managers, folder-to-Markdown combiner, and community plugins."); }
        HorizontalLayout {
            alignment: start;
            AboutSlint { }
        }
    }
}

export component MainWindow inherits Window {
    in property <string> version;
    in-out property <int> page: 0;

    title: "Simplus";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 600px;
    background: Palette.background;

    public function apply-theme() {
        Palette.color-scheme = AppSettings.theme == 1 ? ColorScheme.light : AppSettings.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    init => { root.apply-theme(); }

    HorizontalLayout {
        Rectangle {
            width: Theme.sidebar-width;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text {
                    text: "Simplus";
                    font-size: 18px;
                    font-weight: 700;
                    height: 44px;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                NavItem {
                    label: @tr("Passwords");
                    selected: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    label: @tr("S3 storage");
                    badge: @tr("soon");
                    selected: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    label: @tr("FTP / SFTP");
                    badge: @tr("soon");
                    selected: root.page == 2;
                    clicked => { root.page = 2; }
                }
                NavItem {
                    label: @tr("Combiner");
                    badge: @tr("soon");
                    selected: root.page == 3;
                    clicked => { root.page = 3; }
                }
                NavItem {
                    label: @tr("Plugins");
                    badge: @tr("soon");
                    selected: root.page == 4;
                    clicked => { root.page = 4; }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem {
                    label: @tr("Settings");
                    selected: root.page == 5;
                    clicked => { root.page = 5; }
                }
                NavItem {
                    label: @tr("About");
                    selected: root.page == 6;
                    clicked => { root.page = 6; }
                }
            }
        }
        Rectangle {
            width: 1px;
            background: Palette.border;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.page == 0: VaultPage { }
            if root.page == 1: ComingSoonPage {
                title: @tr("S3 storage");
                description: @tr("Browse any S3-compatible storage and sync folders local↔S3 or S3→S3 on a schedule.");
            }
            if root.page == 2: ComingSoonPage {
                title: @tr("FTP / SFTP");
                description: @tr("Site manager protected by a master password, diff-based sync and schedules.");
            }
            if root.page == 3: ComingSoonPage {
                title: @tr("Combine to Markdown");
                description: @tr("Merge local folders or GitHub repositories into one Markdown file for LLMs.");
            }
            if root.page == 4: ComingSoonPage {
                title: @tr("Plugins");
                description: @tr("Install community modules, like VS Code extensions.");
            }
            if root.page == 5: SettingsPage {
                theme-changed => { root.apply-theme(); }
            }
            if root.page == 6: AboutPage { version: root.version; }
        }
    }
}
